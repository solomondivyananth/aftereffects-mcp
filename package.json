{
  "name": "aftereffects-mcp",
  "version": "0.1.0",
  "description": "Read, view and edit a live Adobe After Effects project from any MCP client",
  "mcpName": "io.github.solomondivyananth/aftereffects-mcp",
  "license": "MIT",
  "author": "Solomon Divyananth",
  "homepage": "https://github.com/solomondivyananth/aftereffects-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solomondivyananth/aftereffects-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/solomondivyananth/aftereffects-mcp/issues"
  },
  "keywords": [
    "mcp", "model-context-protocol", "mcp-server",
    "after-effects", "adobe-after-effects", "adobe",
    "extendscript", "cep", "motion-graphics",
    "animation", "video", "automation", "ai", "claude", "claude-code",
    "ai-agent", "after-effects-mcp", "after-effects-scripting", "cursor"
  ],
  "type": "commonjs",
  "main": "mcp/ae-mcp.js",
  "bin": {
    "aftereffects-mcp": "mcp/ae-mcp.js",
